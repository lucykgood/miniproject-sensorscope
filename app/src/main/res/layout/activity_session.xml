<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Active Session"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSensorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sensor"
            android:textSize="20sp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvElapsedTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Time: 0.0 s"
            android:textSize="18sp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvSampleCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Samples: 0"
            android:textSize="18sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvSensorValues"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="X: 0.000&#10;Y: 0.000&#10;Z: 0.000"
            android:textSize="18sp"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Motion Analysis"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/tvMotionFeature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Motion Feature (M): Waiting for 128 samples..."
            android:textSize="18sp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvMotionLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Motion Level: Waiting for 128 samples..."
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Motion Indicator"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <com.example.lab6_gyroscope.MotionIndicatorView
            android:id="@+id/motionIndicator"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:background="#F0F0F0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Motion Thresholds"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/editThreshold1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="T1 (LOW / MEDIUM boundary)"
            android:inputType="numberDecimal"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/editThreshold2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="T2 (MEDIUM / HIGH boundary)"
            android:inputType="numberDecimal"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnApplyThresholds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apply Thresholds"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Time-Domain Graph"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <com.example.lab6_gyroscope.SensorGraphView
            android:id="@+id/sensorGraph"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="12dp"
            android:background="#F5F5F5" />

        <Button
            android:id="@+id/btnStopSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop Session"
            android:layout_marginTop="32dp" />

    </LinearLayout>
</ScrollView>
